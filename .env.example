# Persistent app data root. SQLite defaults to DATA_PATH/dreamforge.sqlite
# and uploads default to DATA_PATH/uploads unless DATABASE_URL or UPLOADS_DIR is overridden.
DATA_PATH=./data

# Optional explicit SQLite path override. Leave blank to use DATA_PATH/dreamforge.sqlite.
# DATABASE_URL=./data/dreamforge.sqlite

# Optional uploads subdirectory under DATA_PATH.
UPLOADS_DIR=uploads

# Public origin used by Better Auth.
ORIGIN="http://localhost:5173"

# Better Auth secret. For production use at least 32 random characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret"
